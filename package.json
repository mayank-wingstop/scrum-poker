{
  "name": "scrum-poker",
  "private": true,
  "workspaces": [
    "src/client",
    "src/server",
    "src/shared"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=src/client\" \"npm run dev --workspace=src/server\"",
    "build": "npm run build --workspace=src/shared && npm run build --workspace=src/client && npm run build --workspace=src/server",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "start": "node src/server/dist/start.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "@playwright/test": "^1.40.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0"
  }
}
